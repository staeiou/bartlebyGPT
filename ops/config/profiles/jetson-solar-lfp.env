# Jetson Orin Nano — LFP12100EK battery (12V 100Ah 1200Wh) + Victron SmartSolar MPPT 100/20

MODEL=staeiou/bartleby-qwen3-1.7b_v4-awq
VLLM_EXTRA_ARGS="--quantization awq_marlin --dtype float16 --gpu-memory-utilization 0.60 --enforce-eager"
VLLM_MAX_MODEL_LEN=2048

# Battery monitor
ENABLE_BATTERY_MONITOR=1
BATTERY_MONITOR_RUNTIME=telemetry
BATTERY_MONITOR_DEPLOYMENT=./telemetry/deployments/victron-mppt-usb-smartshunt.py
BATTERY_MONITOR_SERVICE_NAME=lfp-monitor
BATTERY_MONITOR_USER=root

BATT_HOST=127.0.0.1
BATT_PORT=18082
BATT_CSV_INTERVAL=60
BATT_HISTORY_DB_PATH=/opt/bartleby/lfp-monitor/logs/history.sqlite3
BATT_CAPACITY_WH=1280
BATT_RECONNECT_DELAY=10
BATTERY_MONITOR_WORKDIR=/opt/bartleby/lfp-monitor

# Independent Waveshare UPS Power Module (C) / INA219 logger.
# This does not feed /telemetry/power and does not share the LFP history database.
ENABLE_UPS_HAT_LOGGER=1
UPS_HAT_LOGGER_SERVICE_NAME=ups-hat-monitor
UPS_HAT_LOGGER_USER=root
UPS_HAT_LOGGER_WORKDIR=/opt/bartleby/ups-hat-monitor
UPS_HAT_LOG_DIR=/opt/bartleby/ups-hat-monitor/logs
UPS_HAT_SQLITE_PATH=/opt/bartleby/ups-hat-monitor/logs/ups_hat.sqlite3
UPS_HAT_I2C_BUS=7
UPS_HAT_I2C_ADDR=0x41
UPS_HAT_LOG_INTERVAL=10

# Victron SmartSolar MPPT 100/20 over VE.Direct USB + SmartShunt over BLE.
# VICTRON_SMARTSHUNT_BLE_ADDR and VICTRON_SMARTSHUNT_ENCRYPTION_KEY are set
# in /root/bartleby-secrets.env.

TELEMETRY_POWER_BACKEND=auto
TELEMETRY_ESPHOME_POWER_URL=http://127.0.0.1:18082/sensor/power
TELEMETRY_IDLE_GPU_WATTS=2
TELEMETRY_BASE_SYSTEM_WATTS=0
TELEMETRY_GPU_COOLING_MULTIPLIER=1.00
TELEMETRY_CLAMP_MIN_WATTS=8
TELEMETRY_CLAMP_MAX_WATTS=25
TELEMETRY_HISTORY_24H_BIN_SECONDS=60
TELEMETRY_HISTORY_CACHE_TTL_SECONDS=120
TELEMETRY_HISTORY_DB_PATH=/opt/bartleby/lfp-monitor/logs/history.sqlite3
TELEMETRY_VLLM_LOG_DIR=/opt/bartleby/vllm-metrics
TELEMETRY_BATTERY_CSV_DIR=/opt/bartleby/lfp-monitor/logs
TELEMETRY_BATTERY_CSV_PREFIX=battery
TELEMETRY_BATTERY_STALE_SECONDS=90
TELEMETRY_BATTERY_AUTO_RECOVER=1
TELEMETRY_BATTERY_RECOVERY_COOLDOWN_SECONDS=180
TELEMETRY_BATTERY_RECOVERY_ESCALATE_EVERY=2

DEPLOYMENT_PROFILE=jetson-solar-lfp
BATTERY_CAPACITY_WH=1280
# Dedicated Victron SmartSolar PV sensor: solar is measured separately from battery
# charge current, so disable the Solix-style 0W-at-full-SoC pass-through fallback and
# prefer the solar_input_w history column. (Replaces the old profile-name magic string.)
BATTERY_SOLAR_MEASURED=1

ENABLE_WEB_APP=1
WEB_APP_DIR=./docs
WEB_APP_PUBLIC_DIR=/var/www/bartlebygpt

ENABLE_CLOUDFLARE_TUNNEL=0
CLOUDFLARE_PUBLIC_HOSTNAME=api.bartlebygpt.org
