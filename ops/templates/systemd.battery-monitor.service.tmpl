[Unit]
Description=Battery BLE Monitor
After=bluetooth.target network.target
Wants=bluetooth.target

[Service]
Type=simple
User={{BATTERY_MONITOR_USER}}
WorkingDirectory={{BATTERY_MONITOR_WORKDIR}}
ExecStart={{BATTERY_MONITOR_EXEC_START}}
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Generic device address — read by lfp_monitor and any future monitor.
Environment=BLE_ADDR={{BLE_ADDR}}
# Solix-specific device address — emitted only for solix_monitor.py.
{{SOLIX_BLE_ADDR_ENV}}
# Canonical BATT_* battery-monitor contract (both monitors read these).
Environment=BATT_HOST={{MONITOR_HOST}}
Environment=BATT_PORT={{MONITOR_PORT}}
Environment=BATT_CSV_DIR={{MONITOR_CSV_DIR}}
Environment=BATT_CSV_INTERVAL={{MONITOR_CSV_INTERVAL}}
Environment=BATT_HISTORY_DB_PATH={{MONITOR_HISTORY_DB_PATH}}
Environment=BATT_CAPACITY_WH={{MONITOR_CAPACITY_WH}}
Environment=BATT_RECONNECT_DELAY={{MONITOR_RECONNECT_DELAY}}
Environment=VICTRON_BLE_ADDR={{VICTRON_BLE_ADDR}}
Environment=VICTRON_ENCRYPTION_KEY={{VICTRON_ENCRYPTION_KEY}}
Environment=VICTRON_SMARTSHUNT_BLE_ADDR={{VICTRON_SMARTSHUNT_BLE_ADDR}}
Environment=VICTRON_SMARTSHUNT_ENCRYPTION_KEY={{VICTRON_SMARTSHUNT_ENCRYPTION_KEY}}

[Install]
WantedBy=multi-user.target
